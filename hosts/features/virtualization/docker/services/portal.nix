{
  config,
  lib,
  ...
}:
let
  version = "v26.08.3"; # imgupdate https://github.com/homarr-labs/homarr/releases
  url = "beta.ko0.net";
  extractSubdomain =
    url:
    let
      withoutProtocol = lib.removePrefix "https://" (lib.removePrefix "http://" url);
      parts = lib.splitString "." withoutProtocol;
    in
    builtins.head parts;

  # Dynamically generate the YAML list items with correct indentation (6 spaces for item, 8 for properties)
  generatedItems = lib.concatMapStringsSep "\n" (
    url:
    let
      subdomain = extractSubdomain url;
    in
    "      - name: \"${subdomain}\"\n        url: \"${url}\""
  ) config.networkAliases;

  config_file = builtins.toFile "config.yml" ''
    title: "Bookmarks"
    subtitle: ""
    icon: "fas fa-skull-crossbones" # Optional icon
    header: false
    footer: false # set false if you want to hide it.
    # Optional theme customization
    theme: default
    colors:
      dark:
        highlight-primary: "#3367d6"
        highlight-secondary: "#4285f4"
        highlight-hover: "#5a95f5"
        background: "#131313"
        card-background: "#2b2b2b"
        text: "#eaeaea"
        text-header: "#ffffff"
        text-title: "#fafafa"
        text-subtitle: "#f5f5f5"
        card-shadow: rgba(0, 0, 0, 0.4)
        link: "#3273dc"
        link-hover: "#ffdd57"
    links: []
    updateIntervalMs: 0 # interval in milliseconds, minimum is 1000 (1s). Remove or set to 0 to disable. Can be overriden at service level. (default disabled)
    services:
      - name: "Applications"
        # icon: "fas fa-cloud"
        items:
    ${generatedItems}
  '';
in

{
  # Runtime
  virtualisation.docker = {
    enable = true;
    autoPrune.enable = true;
  };
  virtualisation.oci-containers.backend = "docker";

  # Containers
  virtualisation.oci-containers.containers."homer" = {
    image = "b4bz/homer:${version}";
    environment = {
      "INIT_ASSETS" = "1";
    };
    volumes = [
      "${config_file}:/www/assets/config.yml:ro"
    ];
    labels = {
      "traefik.docker.network" = "frontend";
      "traefik.enable" = "true";
      "traefik.http.routers.portal-rtr.entrypoints" = "https";
      "traefik.http.routers.portal-rtr.rule" = "Host(`${url}`)";
      "traefik.http.routers.portal-rtr.service" = "portal-svc";
      "traefik.http.routers.portal-rtr.tls" = "true";
      "traefik.http.routers.portal-rtr.tls.certresolver" = "cloudflare";
      "traefik.http.services.portal-svc.loadbalancer.server.port" = "8080";
    };
    user = "1442:100";
    log-driver = "journald";
    extraOptions = [
      "--cpus=0.001"
      "--memory=20971520b"
      "--network-alias=homer"
      "--network=frontend"
    ];
  };
  systemd.services."docker-homer" = {
    serviceConfig = {
      Restart = lib.mkOverride 90 "always";
      RestartMaxDelaySec = lib.mkOverride 90 "1m";
      RestartSec = lib.mkOverride 90 "100ms";
      RestartSteps = lib.mkOverride 90 9;
    };
    unitConfig.Description = "Container homer generated by compose2nix.";
    partOf = [
      "docker-compose-portal-root.target"
    ];
    wantedBy = [
      "docker-compose-portal-root.target"
    ];
  };

  # Root service
  # When started, this will automatically create all resources and start
  # the containers. When stopped, this will teardown all resources.
  systemd.targets."docker-compose-portal-root" = {
    unitConfig = {
      Description = "Root target generated by compose2nix.";
    };
    wantedBy = [ "multi-user.target" ];
  };
}
